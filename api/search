ations/woocommerce-architecture-39","page_id":"/docs/foundations/woocommerce-architecture","tags":[],"type":"text","url":"/docs/foundations/woocommerce-architecture#the-wc-singleton","content":"`WC_Customer`"},"1131":{"id":"/docs/foundations/woocommerce-architecture-40","page_id":"/docs/foundations/woocommerce-architecture","tags":[],"type":"text","url":"/docs/foundations/woocommerce-architecture#the-wc-singleton","content":"Current customer — address, tax location, logged-in or guest"},"1132":{"id":"/docs/foundations/woocommerce-architecture-41","page_id":"/docs/foundations/woocommerce-architecture","tags":[],"type":"text","url":"/docs/foundations/woocommerce-architecture#the-wc-singleton","content":"`WC()->query` (property)"},"1133":{"id":"/docs/foundations/woocommerce-architecture-42","page_id":"/docs/foundations/woocommerce-architecture","tags":[],"type":"text","url":"/docs/foundations/woocommerce-architecture#the-wc-singleton","content":"`WC_Query`"},"1134":{"id":"/docs/foundations/woocommerce-architecture-43","page_id":"/docs/foundations/woocommerce-architecture","tags":[],"type":"text","url":"/docs/foundations/woocommerce-architecture#the-wc-singleton","content":"Front-end query manipulation for shop / product pages"},"1135":{"id":"/docs/foundations/woocommerce-architecture-44","page_id":"/docs/foundations/woocommerce-architecture","tags":[],"type":"text","url":"/docs/foundations/woocommerce-architecture#the-wc-singleton","content":"`WC()->product_factory` / `WC()->order_factory` (property)"},"1136":{"id":"/docs/foundations/woocommerce-architecture-45","page_id":"/docs/foundations/woocommerce-architecture","tags":[],"type":"text","url":"/docs/foundations/woocommerce-architecture#the-wc-singleton","content":"factories"},"1137":{"id":"/docs/foundations/woocommerce-architecture-46","page_id":"/docs/foundations/woocommerce-architecture","tags":[],"type":"text","url":"/docs/foundations/woocommerce-architecture#the-wc-singleton","content":"Build `WC_Product` / `WC_