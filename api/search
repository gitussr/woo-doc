age"},"192":{"id":"/docs/about/design-system-12","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#decision-guide","content":"Decision guide"},"193":{"id":"/docs/about/design-system-13","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#component-gallery","content":"Component gallery"},"194":{"id":"/docs/about/design-system-14","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#pagemeta","content":"`PageMeta`"},"195":{"id":"/docs/about/design-system-15","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#prioritybadge","content":"`PriorityBadge`"},"196":{"id":"/docs/about/design-system-16","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#safetylevel","content":"`SafetyLevel`"},"197":{"id":"/docs/about/design-system-17","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#wherefrom","content":"`WhereFrom`"},"198":{"id":"/docs/about/design-system-18","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#versionnote-and-verifynote","content":"`VersionNote` and `VerifyNote`"},"199":{"id":"/docs/about/design-system-19","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#classicvsblocks","content":"`ClassicVsBlocks`"},"200":{"id":"/docs/about/design-system-20","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#lifecycle","content":"`Lifecycle`"},"201":{"id":"/docs/about/design-system-21","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#layerstack","content":"`LayerStack`"},"202":{"id":"/docs/about/design-system-22","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#decisionguide-and-choice","content":"`DecisionGuide` and `Choice`"},"203":{"id":"/docs/about/design-system-23","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#built-in-components","content":"Built-in components"},"204":{"id":"/docs/about/design-system-24","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#code-example-rules","content":"Code example rules"},"205":{"id":"/docs/about/design-system-25","page_id":"/docs/about/design-system","type":"heading","tags":[],"url":"/docs/about/design-system#related","content":"Related"},"206":{"id":"/docs/about/design-system-26","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system","content":"WooDoc scales by **composition, not prose**. Every page is assembled from a\nsmall set of page templates and content components. This page is the reference\nfor both, and it doubles as a live component gallery."},"207":{"id":"/docs/about/design-system-27","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"Whenever a topic is technical, structure it around these sections — use them\nintelligently, not mechanically. Not every page needs every one."},"208":{"id":"/docs/about/design-system-28","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"Section"},"209":{"id":"/docs/about/design-system-29","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"Answers"},"210":{"id":"/docs/about/design-system-30","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"**What?**"},"211":{"id":"/docs/about/design-system-31","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"Simple explanation first."},"212":{"id":"/docs/about/design-system-32","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"**Why?**"},"213":{"id":"/docs/about/design-system-33","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"Why WooCommerce has this mechanism."},"214":{"id":"/docs/about/design-system-34","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"**Where?**"},"215":{"id":"/docs/about/design-system-35","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"The file, template, hook, filter, function, class, table, setting, JS component, or endpoint."},"216":{"id":"/docs/about/design-system-36","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"**When?**"},"217":{"id":"/docs/about/design-system-37","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"When a developer should use it."},"218":{"id":"/docs/about/design-system-38","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"**When NOT?**"},"219":{"id":"/docs/about/design-system-39","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"Inappropriate use cases."},"220":{"id":"/docs/about/design-system-40","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"**How?**"},"221":{"id":"/docs/about/design-system-41","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system#writing-model","content":"A minimal, correct, copyable implementation."},"222":{"id":"/docs/about/design-system-42