ge_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#mission","content":"Make architectural decisions before writing code."},"396":{"id":"/docs/about/project-definition-23","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#audience","content":"Segment"},"397":{"id":"/docs/about/project-definition-24","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#audience","content":"Starting point"},"398":{"id":"/docs/about/project-definition-25","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#audience","content":"What they struggle with"},"399":{"id":"/docs/about/project-definition-26","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#audience","content":"**Beginner WooCommerce developer**"},"400":{"id":"/docs/about/project-definition-27","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#audience","content":"Knows HTML, CSS, PHP, WordPress, themes, plugins"},"401":{"id":"/docs/about/project-definition-28","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#audience","content":"Gets lost the moment WooCommerce is involved"},"402":{"id":"/docs/about/project-definition-29","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#audience","content":"**Intermediate WordPress developer**"},"403":{"id":"/docs/about/project-definition-30","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#audience","content":"Can build WordPress sites"},"404":{"id":"/docs/about/project-definition-31","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#audience","content":"Templates, hooks, filters, cart, checkout, product architecture, AJAX, orders, payments, shipping, database, HPOS, Blocks"},"405":{"id":"/docs/about/project-definition-32","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#audience","content":"**Advanced developer**"},"406":{"id":"/docs/about/project-definition-33","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#audience","content":"Ships production WordPress"},"407":{"id":"/docs/about/project-definition-34","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#audience","content":"Wants architecture, extension points, internal data flow, debugging strategy, performance, safe patterns, and an honest account of limits"},"408":{"id":"/docs/about/project-definition-35","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#audience","content":"WooDoc serves all three through **progressive complexity**: plain explanation\nfirst, precise developer terminology second."},"409":{"id":"/docs/about/project-definition-36","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#the-problem","content":"WooCommerce functionality is **distributed**. A single visible element may be\ngoverned by WordPress, WooCommerce core, a template, a hook, a filter, PHP,\nJavaScript, AJAX, a REST endpoint, a block, a database value, an extension, or\na theme customization."},"410":{"id":"/docs/about/project-definition-37","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#the-problem","content":"Typical documentation hands developers a snippet. That teaches *what to type*,\nnot *why it works*, *where else it could be done*, or *what it puts at risk*.\nWooDoc connects the pieces."},"411":{"id":"/docs/about/project-definition-38","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#philosophy","content":"WooDoc teaches developers to think differently. Instead of only asking &#x2A;\"how\ndo I change this button?\"*, a developer learns to ask, in order:"},"412":{"id":"/docs/about/project-definition-39","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#philosophy","content":"Two principles carry through every page:"},"413":{"id":"/docs/about/project-definition-40","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#philosophy","content":"Clearly separate **recommended extension** (official hooks, filters, APIs,\nsupported template mechanisms, proper plugin architecture) from **risky\ncustomization** (template overrides, behavior replacement) and **dangerous\ncustomization** (editing core, relying on fragile internals)."},"414":{"id":"/docs/about/project-definition-41","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#philosophy","content":"Document what WooCommerce does out of the box, what needs customization,\nwhat needs an extension, what needs external infrastructure, what is\npossible but architecturally undesirable, and when a different technology is\nthe better choice. Do not blindly promote WooCommerce."},"415":{"id":"/docs/about/project-definition-42","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#differentiator","content":"Most WooCommerce resources are **recipe collections**. WooDoc is a\n**reference that builds a mental model**:"},"416":{"id":"/docs/about/project-definition-43","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#differentiator","content":"Every topic is traced to the **layer** that owns it."},"417":{"id":"/docs/about/project-definition-44","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#differentiator","content":"Every customization is labeled with a **safety level**."},"418":{"id":"/docs/about/project-definition-45","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#differentiator","content":"Every significant change notes its **downstream ripple**."},"419":{"id":"/docs/about/project-definition-46","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#differentiator","content":"Version-specific and classic-vs-Blocks differences are called out\nexplicitly."},"420":{"id":"/docs/about/project-definition-47","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#differentiator","content":"Accuracy is a hard rule: no invented hooks, paths, or behavior."},"421":{"id":"/docs/about/project-definition-48","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#dx-principles","content":"A developer arriving on any WooDoc page should be able to answer quickly:"},"422":{"id":"/docs/about/project-definition-49","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#dx-principles","content":"What is this?"},"423":{"id":"/docs/about/project-definition-50","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#dx-principles","content":"Where does it live?"},"424":{"id":"/docs/about/project-definition-51","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#dx-principles","content":"Why does it exist?"},"425":{"id":"/docs/about/project-definition-52","page_id":"/docs/about/project-definition","tags":[],"type":"text","url":"/docs/about/project-definition#dx-principles","content":"When should I use it?"},"426":{"id":"/docs/about/pro