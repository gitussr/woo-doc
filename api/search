ap#sequencing-notes","content":"The information architecture is revisited at the end of each phase and\nadjusted."},"502":{"id":"/docs/about/roadmap-55","page_id":"/docs/about/roadmap","tags":[],"type":"text","url":"/docs/about/roadmap#related","content":"<Card title=\"Information Architecture\" href=\"/docs/about/information-architecture\" description=\"The section map these phases fill in.\" />"},"503":{"id":"/docs/about/roadmap-56","page_id":"/docs/about/roadmap","tags":[],"type":"text","url":"/docs/about/roadmap#related","content":"<Card title=\"Documentation Design System\" href=\"/docs/about/design-system\" description=\"The templates each phase's pages are built from.\" />"},"504":{"id":"/docs/data-storage/database","page_id":"/docs/data-storage/database","type":"page","content":"Database","breadcrumbs":["Docs","Data & Storage"],"tags":[],"url":"/docs/data-storage/database"},"505":{"id":"/docs/data-storage/database-0","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database","content":"How WooCommerce stores data — the WordPress core tables it reuses, the custom tables it adds on top, why the lookup tables exist, and when to query directly versus go through the CRUD layer."},"506":{"id":"/docs/data-storage/database-1","page_id":"/docs/data-storage/database","type":"heading","tags":[],"url":"/docs/data-storage/database#the-two-tiers","content":"The two tiers"},"507":{"id":"/docs/data-storage/database-2","page_id":"/docs/data-storage/database","type":"heading","tags":[],"url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"What lives in WordPress's tables"},"508":{"id":"/docs/data-storage/database-3","page_id":"/docs/data-storage/database","type":"heading","tags":[],"url":"/docs/data-storage/database#what-woocommerces-own-tables-hold","content":"What WooCommerce's own tables hold"},"509":{"id":"/docs/data-storage/database-4","page_id":"/docs/data-storage/database","type":"heading","tags":[],"url":"/docs/data-storage/database#why-the-lookup-tables-exist","content":"Why the lookup tables exist"},"510":{"id":"/docs/data-storage/database-5","page_id":"/docs/data-storage/database","type":"heading","tags":[],"url":"/docs/data-storage/database#meta-patterns","content":"Meta patterns"},"511":{"id":"/docs/data-storage/database-6","page_id":"/docs/data-storage/database","type":"heading","tags":[],"url":"/docs/data-storage/database#when-to-query-directly-vs-use-the-crud-layer","content":"When to query directly vs. use the CRUD layer"},"512":{"id":"/docs/data-storage/database-7","page_id":"/docs/data-storage/database","type":"heading","tags":[],"url":"/docs/data-storage/database#related","content":"Related"},"513":{"id":"/docs/data-storage/database-8","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database","content":"WooCommerce's storage is two tiers stacked on each other: **WordPress's own\ntables**, which it reuses for content-shaped data, and **WooCommerce's own\ntables**, added for the things WordPress has no concept of — order line\nitems, tax rates, sessions, payment tokens, and fast lookup copies of hot\nfields. Knowing which tier a piece of data lives in is what makes a query\ncorrect instead of merely working today."},"514":{"id":"/docs/data-storage/database-9","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database","content":"The full column-by-column listing is the\nSchema Reference; this page is the\nmap and the judgment calls."},"515":{"id":"/docs/data-storage/database-10","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"WordPress table"},"516":{"id":"/docs/data-storage/database-11","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"WooCommerce uses it for"},"517":{"id":"/docs/data-storage/database-12","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"`wp_posts`"},"518":{"id":"/docs/data-storage/database-13","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"Products (`product`), variations (`product_variation`), coupons (`shop_coupon`); legacy-mode orders (`shop_order`, `shop_order_refund`)"},"519":{"id":"/docs/data-storage/database-14","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"`wp_postmeta`"},"520":{"id":"/docs/data-storage/database-15","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"Product fields (`_price`, `_sku`, `_stock`, …), legacy order fields"},"521":{"id":"/docs/data-storage/database-16","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"`wp_terms` / `wp_term_taxonomy` / `wp_term_relationships`"},"522":{"id":"/docs/data-storage/database-17","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"Product categories/tags, the internal `product_type` and `product_visibility` taxonomies, and one taxonomy per global attribute (`pa_*`)"},"523":{"id":"/docs/data-storage/database-18","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"`wp_users` / `wp_usermeta`"},"524":{"id":"/docs/data-storage/database-19","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"Customer accounts (role `customer`), billing/shipping address meta"},"525":{"id":"/docs/data-storage/database-20","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"`wp_options`"},"526":{"id":"/docs/data-storage/database-21","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"Every store setting (`woocommerce_*` keys), most autoloaded"},"527":{"id":"/docs/data-storage/database-22","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#what-lives-in-wordpresss-tables","content":"Products are still fundamentally **posts**. Orders are the exception — see\nHPOS: a default install stores them in dedicated\ntables, not `wp_posts`."},"528":{"id":"/docs/data-storage/database-23","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#why-the-lookup-tables-exist","content":"`wp_postmeta` and `wp_termmeta` are schemaless: `meta_value` is an\nunindexed-by-value text column, and finding \"all in-stock products under\n$20\" means joining several meta rows per product. WooCommerce keeps\n**denormalized, indexed copies** of the fields that catalog and reporting\nqueries actually filter and sort on:"},"529":{"id":"/docs/data-storage/database-24","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#why-the-lookup-tables-exist","content":"This is the same pattern HPOS applies to the entire order record: replace\nscattered meta rows with real columns. The product lookup table did it for\none entity years earlier."},"530":{"id":"/docs/data-storage/database-25","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"Pattern"},"531":{"id":"/docs/data-storage/database-26","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"Where"},"532":{"id":"/docs/data-storage/database-27","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"Notes"},"533":{"id":"/docs/data-storage/database-28","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"WordPress post meta"},"534":{"id":"/docs/data-storage/database-29","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"`wp_postmeta`"},"535":{"id":"/docs/data-storage/database-30","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"Product and legacy-order fields; underscore-prefixed keys are hidden from the custom-fields UI"},"536":{"id":"/docs/data-storage/database-31","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"WooCommerce order meta"},"537":{"id":"/docs/data-storage/database-32","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"`wc_orders_meta` (HPOS) or `wp_postmeta` (legacy)"},"538":{"id":"/docs/data-storage/database-33","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"Reached only through `$order->get_meta()` / `add_meta_data()` — never a raw table"},"539":{"id":"/docs/data-storage/database-34","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"Order item meta"},"540":{"id":"/docs/data-storage/database-35","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"`woocommerce_order_itemmeta`"},"541":{"id":"/docs/data-storage/database-36","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"Per line item — quantity, tax breakdown, chosen variation attributes"},"542":{"id":"/docs/data-storage/database-37","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"User meta"},"543":{"id":"/docs/data-storage/database-38","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"`wp_usermeta`"},"544":{"id":"/docs/data-storage/database-39","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#meta-patterns","content":"Billing/shipping address for account holders"},"545":{"id":"/docs/data-storage/database-40","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#when-to-query-directly-vs-use-the-crud-layer","content":"Always the CRUD layer — `wc_get_product()`, `wc_get_order()`,\n`new WC_Customer()`. It is correct under both legacy and HPOS storage, and\nkeeps the lookup tables in sync on write."},"546":{"id":"/docs/data-storage/database-41","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#when-to-query-directly-vs-use-the-crud-layer","content":"A direct, read-only query against the appropriate **lookup table**\n(`wc_product_meta_lookup`, the `wc_order_*_lookup` analytics tables) is\nthe sanctioned fast path — it is what WooCommerce's own reports use."},"547":{"id":"/docs/data-storage/database-42","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#when-to-query-directly-vs-use-the-crud-layer","content":"Stop. There is no supported reason to `INSERT`/`UPDATE` these tables\noutside WooCommerce's own code — you will desync the lookup tables, the\norder tables, or both."},"548":{"id":"/docs/data-storage/database-43","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#when-to-query-directly-vs-use-the-crud-layer","content":"Table names, prefixes, and columns on this page and the\nSchema Reference reflect\n`WC_Install::get_schema()` and the HPOS orders-table-store definitions for\nthis release. A few tables are feature-gated (created but not populated\nuntil the related feature is active) — see the reference page."},"549":{"id":"/docs/data-storage/database-44","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#related","content":"<Card title=\"Schema Reference\" href=\"/docs/data-storage/schema-reference\" description=\"Every table, column by column.\" />"},"550":{"id":"/docs/data-storage/database-45","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#related","content":"<Card title=\"HPOS\" href=\"/docs/data-storage/hpos\" description=\"The order-storage tables in depth, including migration.\" />"},"551":{"id":"/docs/data-storage/database-46","page_id":"/docs/data-storage/database","tags":[],"type":"text","url":"/docs/data-storage/database#related","content":"<Card title=\"WooCommerce Data Model\" href=\"/docs/foundations/woocommerce-data-model\" description=\"The entities these tables back, and their CRUD classes.\" />"},"552":{"id":"/docs/data-storage/hpos","page_id":"/docs/data-storage/hpos","type":"page","content":"HPOS (High-Performance Order Storage)","breadcrumbs":["Docs","Data & Storage"],"tags":[],"url":"/docs/data-storage/hpos"},"553":{"id":"/docs/data-storage/hpos-0","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos","content":"How order storage works under HPOS — the four order tables and what each holds, the three storage modes and the sync between them, the migration process, and how to write code that is correct in both legacy and HPOS stores."},"554":{"id":"/docs/data-storage/hpos-1","page_id":"/docs/data-storage/hpos","type":"heading","tags":[],"url":"/docs/data-storage/hpos#why-hpos-exists","content":"Why HPOS exists"},"555":{"id":"/docs/data-storage/hpos-2","page_id":"/docs/data-storage/hpos","type":"heading","tags":[],"url":"/docs/data-storage/hpos#the-four-tables","content":"The four tables"},"556":{"id":"/docs/data-storage/hpos-3","page_id":"/docs/data-storage/hpos","type":"heading","tags":[],"url":"/docs/data-storage/hpos#three-storage-modes","content":"Three storage modes"},"557":{"id":"/docs/data-storage/hpos-4","page_id":"/docs/data-storage/hpos","type":"heading","tags":[],"url":"/docs/data-storage/hpos#migration","content":"Migration"},"558":{"id":"/docs/data-storage/hpos-5","page_id":"/docs/data-storage/hpos","type":"heading","tags":[],"url":"/docs/data-storage/hpos#writing-code-that-works-in-both-modes","content":"Writing code that works in both modes"},"559":{"id":"/docs/data-storage/hpos-6","page_id":"/docs/data-storage/hpos","type":"heading","tags":[],"url":"/docs/data-storage/hpos#what-does-not-change","content":"What does not change"},"560":{"id":"/docs/data-storage/hpos-7","page_id":"/docs/data-storage/hpos","type":"heading","tags":[],"url":"/docs/data-storage/hpos#related","content":"Related"},"561":{"id":"/docs/data-storage/hpos-8","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos","content":"High-Performance Order Storage replaces \"an order is a post\" with \"an order\nis rows in tables shaped for orders.\" It has been the default for **new**\nWooCommerce installs since version 8.2; stores created earlier keep legacy\nstorage until a merchant migrates. Either way, the `WC_Order` API is\nidentical — this page is about what changes underneath it, and what a\nplugin author must do to stay correct across both."},"562":{"id":"/docs/data-storage/hpos-9","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#why-hpos-exists","content":"An order as a `shop_order` post meant every field — status, totals,\naddresses, payment details — was a separate row in `wp_postmeta`, an\nunindexed-by-value table shared with every other post type on the site.\nHigh-volume stores felt this as slow order queries, lock contention during\ncheckout, and a `wp_postmeta` table that dwarfed everything else in the\ndatabase."},"563":{"id":"/docs/data-storage/hpos-10","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#why-hpos-exists","content":"HPOS gives orders their own tables with real, indexed columns — the same\n\"stop abusing postmeta\" move the\nproduct meta lookup table\nmade for products years earlier, applied to the entire order record."},"564":{"id":"/docs/data-storage/hpos-11","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#the-four-tables","content":"`woocommerce_order_items` and `woocommerce_order_itemmeta` (the line items,\nshipping, fees, coupons, tax) are **not part of HPOS** — they had their own\ndedicated tables long before HPOS existed, and HPOS did not need to touch\nthem. Only the order *record* moved."},"565":{"id":"/docs/data-storage/hpos-12","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#three-storage-modes","content":"Compatibility mode exists so a store — and every plugin it runs — can be\nverified against both storages before HPOS becomes authoritative. It costs a\nwrite penalty (every order write happens twice) in exchange for a safe\nrollback."},"566":{"id":"/docs/data-storage/hpos-13","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#migration","content":"Switching an existing store from legacy to HPOS is a background job, not a\nflag flip:"},"567":{"id":"/docs/data-storage/hpos-14","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#migration","content":"Migration and ongoing sync are driven internally by\n`Automattic\\WooCommerce\\Internal\\DataStores\\Orders\\DataSynchronizer` (batched\nvia Action Scheduler) and `PostsToOrdersMigrationController`. The same\noperations are exposed as WP-CLI commands through `CLIRunner`, under the\n`wp wc hpos` namespace (the older `wp wc cot` namespace still works but is\ndeprecated): `wp wc hpos sync` migrates the currently-authoritative store to\nthe other one, and `wp wc hpos backfill` does the same with per-order /\nper-field control — the practical choice for a large store where the\nbackground batches are too slow."},"568":{"id":"/docs/data-storage/hpos-15","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#migration","content":"Legacy `wp_posts` / `wp_postmeta` rows are **not** deleted automatically once\nHPOS becomes authoritative — migration only copies data forward. Deleting\nthem is a separate, explicit step: `wp wc hpos cleanup` removes the legacy\npostmeta (and post rows) for orders already migrated, but even then it keeps\na lightweight placeholder post (`shop_order_placehold`) per order so the\nstore can still be switched back to legacy storage without re-migrating."},"569":{"id":"/docs/data-storage/hpos-16","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#migration","content":"On a store with a non-trivial order history, run the migration during low\ntraffic and watch **WooCommerce → Status → Scheduled Actions** for the\nbatch jobs — do not force it to complete synchronously."},"570":{"id":"/docs/data-storage/hpos-17","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#writing-code-that-works-in-both-modes","content":"`wc_get_order( $id )` / `wc_get_orders( $args )` and the `WC_Order`\ngetters/setters. This is storage-agnostic by design — the same call works\nwhichever mode is authoritative."},"571":{"id":"/docs/data-storage/hpos-18","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#writing-code-that-works-in-both-modes","content":"`wc_get_orders()` with its query args, not `WP_Query` and not a\nhand-written join against `wp_posts`. Under HPOS, `WP_Query` for orders\nreturns nothing."},"572":{"id":"/docs/data-storage/hpos-19","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#writing-code-that-works-in-both-modes","content":"Detect the active mode first\n(`Automattic\\WooCommerce\\Utilities\\OrderUtil::custom_orders_table_usage_is_enabled()`)\nand branch — query `wc_orders` or `wp_posts` accordingly. Treat this as a\nlast resort, and re-check it against every WooCommerce update."},"573":{"id":"/docs/data-storage/hpos-20","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#writing-code-that-works-in-both-modes","content":"Declare compatibility explicitly — see\nArchitecture → bootstrap:\n`FeaturesUtil::declare_compatibility( 'custom_order_tables', __FILE__, true )`\non `before_woocommerce_init`, after auditing for direct table/postmeta\naccess."},"574":{"id":"/docs/data-storage/hpos-21","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#writing-code-that-works-in-both-modes","content":"Reading or writing order data with `get_post_meta()` / `update_post_meta()`,\nor querying `wp_posts` for `shop_order`. Under HPOS this silently reads\nstale data or writes to a table nothing else looks at — the failure mode is\ndata that is subtly wrong, not an error."},"575":{"id":"/docs/data-storage/hpos-22","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#what-does-not-change","content":"The `WC_Order`, `WC_Order_Item_*`, and `WC_Order_Refund` **APIs are\nidentical** in both modes — same getters, same setters, same hooks, same\nstatus-transition events.\nHPOS is a storage-layer change; it is not a new order lifecycle."},"576":{"id":"/docs/data-storage/hpos-23","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#related","content":"<Card title=\"WooCommerce Data Model\" href=\"/docs/foundations/woocommerce-data-model\" description=\"Orders and order items in the overall entity model.\" />"},"577":{"id":"/docs/data-storage/hpos-24","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#related","content":"<Card title=\"Database\" href=\"/docs/data-storage/database\" description=\"Where HPOS's tables sit among WooCommerce's other custom tables.\" />"},"578":{"id":"/docs/data-storage/hpos-25","page_id":"/docs/data-storage/hpos","tags":[],"type":"text","url":"/docs/data-storage/hpos#related","content":"<Card title=\"Orders\" href=\"/docs/lifecycle/orders\" description=\"The status lifecycle these tables record — unaffected by which mode is active.\" />"},"579":{"id":"/docs/data-storage/schema-reference","page_id":"/docs/data-storage/schema-reference","type":"page","content":"Schema Reference","breadcrumbs":["Docs","Data & Storage"],"tags":[],"url":"/docs/data-storage/schema-reference"},"580":{"id":"/docs/data-storage/schema-reference-0","page_id":"/docs/data-storage/schema-reference","tags":[],"type":"text","url":"/docs/data-storage/schema-reference","content":"Every WooCommerce-defined database table and its columns — order storage, order items, catalog and customer lookup tables, tax and shipping config, sessions and security, and operational tables."},"581":{"id":"/docs/data-storage/schema-reference-1","page_id":"/docs/data-storage/schema-reference","type":"heading","tags":[],"url":"/docs/data-storage/schema-reference#orders-hpos","content":"Orders (HPOS)"},"582":{"id":"/docs/data-storage/schema-reference-2","page_id":"/docs/data-storage/schema-reference","type":"heading","tags":[],"url":"/docs/data-storage/schema-reference#wc_orders","content":"`wc_orders`"},"583":{"id":"/docs/data-storage/schema-reference-3","page_id":"/docs/data-storage/schema-reference","type":"heading","tags":[],"url":"/docs/data-storage/schema-reference#wc_order_addresses","content":"`wc_order_addresses`"},"584":{"id":"/docs/data-storage/schema-reference-4","page_id":"/docs/data-storage/schema-reference","type":"heading","tags":[],"url":"/docs/data-storage/schema-reference#wc_order_operational_data","content":"`wc_order_operational_data`"},"585":{"id":"/docs/data-storage/schema-reference-5","page_id":"/docs/data-storage/schema-reference","type":"heading","tags":[],"url":"/docs/data-storage/schema-reference#wc_orders_meta","content":"`wc_orders_meta`"},"586":{"id":"/docs/data-storage/schema-reference-6","page_id":"/docs/data-storage/schema-reference","type":"heading","tags":[],"url":"/docs/data-storage/schema-reference#order-line-items","content":"Order line items"},"587":{"id":"/docs/data-storage/schema-reference-7","page_id":"/docs/data-storage/schema-reference","type":"heading","tags":[],"url":"/docs/data-storage/schema-reference#woocommerce_order_items","content":"`woocommerce_order_items`"},"588":{"id":"/docs/data-storage/schema-reference-8","page_id":"/docs/data-storage/schema-reference","type":"heading","tags":[],"url":"/docs/data-storage/schema-reference#woocommerce_order_itemmeta","content":"`woocommerce_order_itemmeta`"},"589":{"id":"/docs/data-storage/schema-reference-9","page_id":"/docs/data-storage/schema-reference","type":"heading","tags":[],"url":"/docs/data-storage/schema-reference#catalog-and-customer-lookup-tables","content":"Catalog and customer lookup tables"},"590":{"id":"/docs/data-storage/schema-reference-10","page_id":"/docs/data-storage/schema-reference","type":"heading","tags":[],"url":"/docs/data-storage/schema-reference#wc_product_meta_lookup","content":"`wc_product_meta_lookup`"},"591":{"id":"/docs/data-storage/schema-reference-11","page_id":"/docs/data-storage/schema-reference","type":"heading","tags":[],"url":"/docs/data-storage/schema-reference#wc_product_attributes_lookup","content":"`wc_product_attributes_lookup`"},"592":{"id":"/docs/data-storage/schema-reference-