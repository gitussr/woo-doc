9":4,"1730":4,"1731":4,"1732":4,"1733":4,"1734":4,"1735":4,"1736":4,"1737":4,"1738":4,"1739":4,"1740":4,"1741":4,"1742":4,"1743":4,"1744":4,"1745":4,"1746":4,"1747":4,"1748":4,"1749":4,"1750":4,"1751":4,"1752":4,"1753":4,"1754":4,"1755":4,"1756":4,"1757":4,"1758":4,"1759":4,"1760":4,"1761":4,"1762":4,"1763":4,"1764":4,"1765":4,"1766":4,"1767":4,"1768":4,"1769":4,"1770":4,"1771":3,"1772":3,"1773":4,"1774":4,"1775":4,"1776":4,"1777":4,"1778":4,"1779":4,"1780":4,"1781":3,"1782":4,"1783":4,"1784":4,"1785":4,"1786":4,"1787":4,"1788":4,"1789":4,"1790":4,"1791":4,"1792":4,"1793":4,"1794":4,"1795":4,"1796":4,"1797":4}}},"docs":{"docs":{"1":{"id":"/docs/customization","page_id":"/docs/customization","type":"page","content":"Customization","breadcrumbs":["Docs"],"tags":[],"url":"/docs/customization"},"2":{"id":"/docs/customization-0","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization","content":"Applied customization patterns that cut across subsystems — plugin vs mu-plugin vs child theme, Blocks customization worked end to end, and the safety-level framework applied to the requests developers actually get."},"3":{"id":"/docs/customization-1","page_id":"/docs/customization","type":"heading","tags":[],"url":"/docs/customization#plugin-vs-mu-plugin-vs-child-theme","content":"Plugin vs. mu-plugin vs. child theme"},"4":{"id":"/docs/customization-2","page_id":"/docs/customization","type":"heading","tags":[],"url":"/docs/customization#a-blocks-customization-worked-end-to-end","content":"A Blocks customization, worked end to end"},"5":{"id":"/docs/customization-3","page_id":"/docs/customization","type":"heading","tags":[],"url":"/docs/customization#applied-safety-level-scenarios","content":"Applied safety-level scenarios"},"6":{"id":"/docs/customization-4","page_id":"/docs/customization","type":"heading","tags":[],"url":"/docs/customization#related","content":"Related"},"7":{"id":"/docs/customization-5","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization","content":"WooCommerce Extension Model is the map\nof the four mechanisms — actions, filters, template overrides, Blocks. This\npage is the applied companion: where the *code* that uses those mechanisms\nshould live, how a Blocks customization actually plays out end to end, and a\nworked library of real requests mapped to a mechanism and a safety level."},"8":{"id":"/docs/customization-6","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#plugin-vs-mu-plugin-vs-child-theme","content":"All three can hold the exact same `add_action()` / `add_filter()` call. The\nchoice is about **lifecycle and ownership**, not capability."},"9":{"id":"/docs/customization-7","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#plugin-vs-mu-plugin-vs-child-theme","content":"A regular plugin. It shows up in **Plugins**, can be versioned and\nupdated independently of the theme, survives a theme change, and can use\nactivation/deactivation hooks to set up or clean up its own data."},"10":{"id":"/docs/customization-8","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#plugin-vs-mu-plugin-vs-child-theme","content":"A **must-use plugin** (a file dropped in `wp-content/mu-plugins/`).\nWordPress loads every file there automatically, before regular plugins'\n`plugins_loaded`, and it never appears in the deactivatable **Plugins**\nlist. Trade-off: no activation/deactivation hooks, no auto-updates, and\n(native WordPress limitation) only files directly in `mu-plugins/` load —\na plugin that ships in its own subdirectory needs a one-line loader file\nat the top level that `require`s it."},"11":{"id":"/docs/customization-9","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#plugin-vs-mu-plugin-vs-child-theme","content":"Child theme `functions.php`. Fine for things like enqueueing a stylesheet\ntweak or adjusting an archive's column count. Not for anything the store\ndepends on functioning — a theme switch silently deletes it."},"12":{"id":"/docs/customization-10","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#plugin-vs-mu-plugin-vs-child-theme","content":"It has one legal home regardless of the above: the child theme's\n`woocommerce/` folder — see\nTemplates."},"13":{"id":"/docs/customization-11","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#plugin-vs-mu-plugin-vs-child-theme","content":"Default to a regular plugin. Reach for a mu-plugin only for the narrow case\nof \"this must never be off\" — a compatibility declaration a client keeps\naccidentally disabling, a security patch while a real fix ships, a hard\nbusiness rule. Everything else benefits from being deactivatable while you\ndebug it."},"14":{"id":"/docs/customization-12","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#a-blocks-customization-worked-end-to-end","content":"Adding a \"gift note\" field to checkout shows how the mechanisms in the\nBlocks layer\ncombine in practice — and how differently the same feature is built classic\nvs. Blocks:"},"15":{"id":"/docs/customization-13","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#a-blocks-customization-worked-end-to-end","content":"These are two separate implementations of the same feature. Supporting\nboth classic and Blocks checkout means shipping both code paths — there is\nno filter that works on both. Check which one the store actually runs\nbefore building either."},"16":{"id":"/docs/customization-14","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"The same request can be reached at more than one mechanism; this table picks\nthe one WooDoc recommends and why."},"17":{"id":"/docs/customization-15","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Request"},"18":{"id":"/docs/customization-16","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Mechanism"},"19":{"id":"/docs/customization-17","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Safety"},"20":{"id":"/docs/customization-18","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Change the \"Add to cart\" button text"},"21":{"id":"/docs/customization-19","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Filter — `woocommerce_product_add_to_cart_text` (archive/loop) or `woocommerce_product_single_add_to_cart_text` (single product)"},"22":{"id":"/docs/customization-20","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"**Recommended**"},"23":{"id":"/docs/customization-21","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Add a custom field to the product admin screen"},"24":{"id":"/docs/customization-22","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Action pair — `woocommerce_product_options_general_product_data` (render) + `woocommerce_process_product_meta` (save)"},"25":{"id":"/docs/customization-23","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"**Recommended**"},"26":{"id":"/docs/customization-24","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Hide a payment gateway for certain shipping zones/products"},"27":{"id":"/docs/customization-25","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Filter — `woocommerce_available_payment_gateways`"},"28":{"id":"/docs/customization-26","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"**Recommended**"},"29":{"id":"/docs/customization-27","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Add a field to the classic checkout"},"30":{"id":"/docs/customization-28","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Filter — `woocommerce_checkout_fields`"},"31":{"id":"/docs/customization-29","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"**Recommended**"},"32":{"id":"/docs/customization-30","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Add a field to the Checkout **Block**"},"33":{"id":"/docs/customization-31","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Slot/Fill or a registered checkout block + Store API `ExtendSchema` — see above"},"34":{"id":"/docs/customization-32","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"**Recommended** (for Blocks)"},"35":{"id":"/docs/customization-33","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Restructure the cart page's markup beyond what hooks reach"},"36":{"id":"/docs/customization-34","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Classic template override (`cart/cart.php`)"},"37":{"id":"/docs/customization-35","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"**Risky** — you now own a forked file"},"38":{"id":"/docs/customization-36","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"\"Add a field to the checkout\" on a **Blocks** store via a classic template override"},"39":{"id":"/docs/customization-37","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Does nothing — the Block does not render that template"},"40":{"id":"/docs/customization-38","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"**Dangerous** — wrong mechanism entirely, ships broken"},"41":{"id":"/docs/customization-39","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Patch a bug by editing `wp-content/plugins/woocommerce/…` directly"},"42":{"id":"/docs/customization-40","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"None — edit core"},"43":{"id":"/docs/customization-41","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"**Dangerous** — reverted on the next update"},"44":{"id":"/docs/customization-42","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Inside a `woocommerce_process_product_meta` callback, save through\n`$product->update_meta_data( $key, $value ); $product->save();` — never a\ndirect `update_post_meta()` call. The CRUD save is what keeps the value\ncorrect if the product data model changes; going straight to postmeta\nbypasses it."},"45":{"id":"/docs/customization-43","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#applied-safety-level-scenarios","content":"Every row above is really the same question from\nWhere Does This Come From?:\nfind the layer, pick the safest mechanism that layer exposes, and stop the\nmoment a filter or action reaches it."},"46":{"id":"/docs/customization-44","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#related","content":"<Card title=\"WooCommerce Extension Model\" href=\"/docs/foundations/extension-model\" description=\"The four mechanisms this page assumes — read that one first.\" />"},"47":{"id":"/docs/customization-45","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#related","content":"<Card title=\"Templates\" href=\"/docs/development/templates\" description=\"The override mechanism referenced above, in depth.\" />"},"48":{"id":"/docs/customization-46","page_id":"/docs/customization","tags":[],"type":"text","url":"/docs/customization#related","content":"<Card title=\"Blocks\" href=\"/docs/development/blocks\" description=\"Slot/Fill, IntegrationInterface, and the Store API extension points.\" />"},"49":{"id":"/docs/debugging","page_id":"/docs/debugging","type":"page","content":"Debugging","breadcrumbs":["Docs"],"tags":[],"url":"/docs/debugging"},"50":{"id":"/docs/debugging-0","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging","content":"How to diagnose unexpected WooCommerce behavior methodically — logging, the System Status report, plugin-conflict isolation, reading the calculation pipeline, and common failure signatures with their causes."},"51":{"id":"/docs/debugging-1","page_id":"/docs/debugging","type":"heading","tags":[],"url":"/docs/debugging#logging","content":"Logging"},"52":{"id":"/docs/debugging-2","page_id":"/docs/debugging","type":"heading","tags":[],"url":"/docs/debugging#the-status-report","content":"The status report"},"53":{"id":"/docs/debugging-3","page_id":"/docs/debugging","type":"heading","tags":[],"url":"/docs/debugging#hook-tracing","content":"Hook tracing"},"54":{"id":"/docs/debugging-4","page_id":"/docs/debugging","type":"heading","tags":[],"url":"/docs/debugging#plugin-conflict-isolation","content":"Plugin-conflict isolation"},"55":{"id":"/docs/debugging-5","page_id":"/docs/debugging","type":"heading","tags":[],"url":"/docs/debugging#reading-the-calculation-pipeline","content":"Reading the calculation pipeline"},"56":{"id":"/docs/debugging-6","page_id":"/docs/debugging","type":"heading","tags":[],"url":"/docs/debugging#common-failure-signatures","content":"Common failure signatures"},"57":{"id":"/docs/debugging-7","page_id":"/docs/debugging","type":"heading","tags":[],"url":"/docs/debugging#related","content":"Related"},"58":{"id":"/docs/debugging-8","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging","content":"WooCommerce failures rarely have one cause. A methodical order — check the\nlog, check the environment, isolate the conflict, then read the relevant\npipeline — finds the answer faster than guessing at a hook."},"59":{"id":"/docs/debugging-9","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#logging","content":"`wc_get_logger()` returns a shared PSR-3-style logger (`emergency` down to\n`debug`). Core and most extensions write through it rather than raw\n`error_log()`:"},"60":{"id":"/docs/debugging-10","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#logging","content":"`WC_Log_Handler_File` rotates a source's log file once it passes **5 MB**:\nthe current file is renumbered `.0`, existing numbered files shift up, and\nthe oldest (`.9`) is deleted — up to 10 historical files plus the current\none. Rotation is size-based, not scheduled; nothing deletes old logs by\nage automatically (`WC_Log_Handler_File::delete_logs_before_timestamp()`\nexists for that, but has to be called explicitly, e.g. from a cron task)."},"61":{"id":"/docs/debugging-11","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#the-status-report","content":"**WooCommerce → Status** is the first stop for any \"why is this broken\"\nquestion:"},"62":{"id":"/docs/debugging-12","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#the-status-report","content":"An **out-of-date template** (\"version X is out of date. The core version\nis Y\") on this page is a leading cause of \"this update broke my site\" —\nsee Templates.\nCheck this list before assuming the bug is in WooCommerce itself."},"63":{"id":"/docs/debugging-13","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#hook-tracing","content":"Tracing which hooks actually fire (and in what order) on a given request is\ncovered in depth on\nHooks — Debugging which hooks fire:\nthe `all` hook trick, reading `wc-template-hooks.php`, and the Query Monitor\nplugin, which lists every hook fired on a request with its registered\ncallbacks and file locations. Reach for that page once logging and the\nstatus report have ruled out an environment problem."},"64":{"id":"/docs/debugging-14","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#plugin-conflict-isolation","content":"WooCommerce sits between WordPress core, the theme, and every other plugin —\nmost \"WooCommerce is doing something weird\" reports are actually a\nthird-party callback on a WooCommerce hook."},"65":{"id":"/docs/debugging-15","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#plugin-conflict-isolation","content":"A \"Troubleshooting\" / \"Health Check\" style plugin that lets *you* see the\nsite with plugins disabled while other visitors still see the live site is\nthe safe way to run this bisection in production."},"66":{"id":"/docs/debugging-16","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#reading-the-calculation-pipeline","content":"\"The cart/order total is wrong\" is common enough to warrant its own entry\npoint: the pipeline is\n`WC_Cart_Totals`, invoked from\n`WC_Cart::calculate_totals()` on the `woocommerce_before_calculate_totals`\n→ calculate → `woocommerce_after_calculate_totals` sequence. A breakpoint or\ntemporary log line at the start and end of that method, dumping cart\ncontents and fees, isolates whether a plugin changed an item's price\n(`woocommerce_before_calculate_totals`) or whether the discrepancy is in\ntax/shipping/coupon math WooCommerce computed itself."},"67":{"id":"/docs/debugging-17","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"Symptom"},"68":{"id":"/docs/debugging-18","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"Likely cause"},"69":{"id":"/docs/debugging-19","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"Where to look"},"70":{"id":"/docs/debugging-20","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"White screen after activating a plugin/update"},"71":{"id":"/docs/debugging-21","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"PHP fatal error"},"72":{"id":"/docs/debugging-22","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"`wp-content/debug.log`, or your host's PHP error log"},"73":{"id":"/docs/debugging-23","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"Checkout hangs on \"Place order\" with no error"},"74":{"id":"/docs/debugging-24","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"A JS error stopped `checkout.js`, or a `woocommerce_checkout_process`/`_before_order_pay` callback exited without a WooCommerce-aware error"},"75":{"id":"/docs/debugging-25","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"Browser console; then the checkout hooks on AJAX"},"76":{"id":"/docs/debugging-26","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"Transactional emails not arriving"},"77":{"id":"/docs/debugging-27","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"`wp_mail()` failing silently (no configured SMTP), or the email is disabled in **Settings → Emails**"},"78":{"id":"/docs/debugging-28","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"**Status → Logs**, source `emails`; see Emails"},"79":{"id":"/docs/debugging-29","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"Prices/stock briefly wrong after a product save"},"80":{"id":"/docs/debugging-30","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"A caching layer (object cache or page cache) serving a stale page before the lookup table sync completed"},"81":{"id":"/docs/debugging-31","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"Purge the relevant cache; confirm the lookup table row updated"},"82":{"id":"/docs/debugging-32","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"REST API request returns 401"},"83":{"id":"/docs/debugging-33","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"Bad or revoked consumer key/secret, wrong permission level for the requested method"},"84":{"id":"/docs/debugging-34","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"**Settings → Advanced → REST API**; see REST API"},"85":{"id":"/docs/debugging-35","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"A hook callback \"never fires\""},"86":{"id":"/docs/debugging-36","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"Registered after the action already ran, or firing only in a request context (admin/REST/cron) the callback wasn't registered for"},"87":{"id":"/docs/debugging-37","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#common-failure-signatures","content":"Hooks — Debugging which hooks fire"},"88":{"id":"/docs/debugging-38","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#related","content":"<Card title=\"Hooks (Actions)\" href=\"/docs/development/hooks\" description=\"Hook-tracing tools this page points to rather than repeats.\" />"},"89":{"id":"/docs/debugging-39","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#related","content":"<Card title=\"Cart\" href=\"/docs/lifecycle/cart\" description=\"The totals pipeline referenced above, in depth.\" />"},"90":{"id":"/docs/debugging-40","page_id":"/docs/debugging","tags":[],"type":"text","url":"/docs/debugging#related","content":"<Card title=\"Performance\" href=\"/docs/performance\" description=\"When the symptom is slow rather than wrong.\" />"},"91":{"id":"/docs","page_id":"/docs","type":"page","content":"Start Here","breadcrumbs":["Docs"],"tags":[],"url":"/docs"},"92":{"id":"/docs-0","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"WooDoc is a developer-first WooCommerce engineering reference. This page explains what it is, who it is for, the problem it solves, and where to begin."},"93":{"id":"/docs-1","page_id":"/docs","type":"heading","tags":[],"url":"/docs#what-woodoc-is","content":"What WooDoc is"},"94":{"id":"/docs-2","page_id":"/docs","type":"heading","tags":[],"url":"/docs#who-it-is-for","content":"Who it is for"},"95":{"id":"/docs-3","page_id":"/docs","type":"heading","tags":[],"url":"/docs#what-problem-it-solves","content":"What problem it solves"},"96":{"id":"/docs-4","page_id":"/docs","type":"heading","tags":[],"url":"/docs#what-you-will-learn","content":"What you will learn"},"97":{"id":"/docs-5","page_id":"/docs","type":"heading","tags":[],"url":"/docs#how-woodoc-thinks","content":"How WooDoc thinks"},"98":{"id":"/docs-6","page_id":"/docs","type":"heading","tags":[],"url":"/docs#version-context","content":"Version context"},"99":{"id":"/docs-7","page_id":"/docs","type":"heading","tags":[],"url":"/docs#this-is-step-1","content":"This is Step 1"},"100":{"id":"/docs-8","page_id":"/docs","type":"heading","tags":[],"url":"/docs#where-to-go-next","content":"Where to go next"},"101":{"id":"/docs-9","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"WooCommerce can feel like a black box. A button appears on a page and you\ncannot tell whether it came from a PHP template, a hook, a block, a shortcode,\na script, or an AJAX response. You want to change one number and you are not\nsure what else moves when you do."},"102":{"id":"/docs-10","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"**WooDoc exists to remove that fog.** It is a reference for developers who\nalready know WordPress and now need to understand WooCommerce deeply enough to\nbuild, customize, extend, and debug it with confidence."},"103":{"id":"/docs-11","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-woodoc-is","content":"A developer-first WooCommerce **engineering reference** — not a \"how to run\nyour store\" tutorial and not a marketing site."},"104":{"id":"/docs-12","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-woodoc-is","content":"Its job is to connect the pieces that WooCommerce functionality is spread\nacross:"},"105":{"id":"/docs-13","page_id":"/docs","tags":[],"type":"text","url":"/docs#who-it-is-for","content":"WooDoc is written for **WordPress developers moving into WooCommerce**."},"106":{"id":"/docs-14","page_id":"/docs","tags":[],"type":"text","url":"/docs#who-it-is-for","content":"**Beginner WooCommerce developer** — comfortable with HTML, CSS, PHP,\nWordPress themes and plugins, but disoriented once WooCommerce is involved."},"107":{"id":"/docs-15","page_id":"/docs","tags":[],"type":"text","url":"/docs#who-it-is-for","content":"**Intermediate WordPress developer** — can build WordPress sites, but\nstruggles with templates, hooks, the cart, checkout, product data, AJAX,\norders, payments, shipping, the database, HPOS, and Blocks."},"108":{"id":"/docs-16","page_id":"/docs","tags":[],"type":"text","url":"/docs#who-it-is-for","content":"**Advanced developer** — wants architecture, extension points, internal\ndata flow, debugging strategy, performance considerations, and an honest\naccount of WooCommerce's limits."},"109":{"id":"/docs-17","page_id":"/docs","tags":[],"type":"text","url":"/docs#who-it-is-for","content":"Every page uses **progressive complexity**: the plain-language explanation\nfirst, the precise developer terminology second."},"110":{"id":"/docs-18","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-problem-it-solves","content":"WooCommerce functionality is distributed. The same visible element can be\ninfluenced by WordPress, WooCommerce core, a template, a hook, a filter, PHP,\nJavaScript, AJAX, a REST endpoint, a block, a database value, an extension, or\na theme customization."},"111":{"id":"/docs-19","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-problem-it-solves","content":"Most documentation and blog posts hand you a snippet to paste. That teaches\nyou *what to type* but not *why it works*, *where else you could have done it*,\nor *what you just put at risk*. WooDoc connects those pieces so you can make\nthe decision yourself."},"112":{"id":"/docs-20","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-you-will-learn","content":"From WooCommerce fundamentals through to safely modifying complex WooCommerce\nfunctionality. The documentation is designed to take you along this path:"},"113":{"id":"/docs-21","page_id":"/docs","tags":[],"type":"text","url":"/docs#how-woodoc-thinks","content":"Two principles run through every page:"},"114":{"id":"/docs-22","page_id":"/docs","tags":[],"type":"text","url":"/docs#how-woodoc-thinks","content":"WooDoc distinguishes **recommended extension** (official hooks, filters,\nAPIs, supported template mechanisms) from **risky customization** (template\noverrides, replacing behavior) and **dangerous customization** (editing core\nfiles, relying on fragile internals). &#x2A;Just because you can change it there\ndoes not mean you should.*"},"115":{"id":"/docs-23","page_id":"/docs","tags":[],"type":"text","url":"/docs#how-woodoc-thinks","content":"WooCommerce cannot do everything well. WooDoc explains what it does out of\nthe box, what needs customization, what needs an extension, what needs\nexternal infrastructure, and when a different stack (custom PHP, Laravel,\na Node service, a dedicated platform) is the better engineering choice."},"116":{"id":"/docs-24","page_id":"/docs","tags":[],"type":"text","url":"/docs#version-context","content":"WooDoc currently documents against these versions. Version-specific behavior\nis called out explicitly, and differences between **classic templates** and\n**WooCommerce Blocks** are noted where they matter."},"117":{"id":"/docs-25","page_id":"/docs","tags":[],"type":"text","url":"/docs#this-is-step-1","content":"WooDoc is being built incrementally. This first release establishes the\nfoundation: the project definition, the information architecture, the content\ndesign system, and the first conceptual chapters. It deliberately does **not**\ntry to document every hook, template, setting, or database table yet — that is\nwhat later phases are for. See the Roadmap."},"118":{"id":"/docs-26","page_id":"/docs","tags":[],"type":"text","url":"/docs#where-to-go-next","content":"<Card title=\"Why WooCommerce?\" href=\"/docs/introduction/why-woocommerce\" description=\"What it solves, what it adds to WordPress, the trade-offs, and when it is the wrong tool.\" />"},"119":{"id":"/docs-27","page_id":"/docs","tags":[],"type":"text","url":"/docs#where-to-go-next","content":"<Card title=\"Developer Mental Model\" href=\"/docs/introduction/developer-mental-model\" description=\"Why building a store is not building a brochure site.\" />"},"120":{"id":"/docs-28","page_id":"/docs","tags":[],"type":"text","url":"/docs#where-to-go-next","content":"<Card title=\"Where Does This Come From?\" href=\"/docs/introduction/where-does-this-come-from\" description=\"WooDoc's signature pattern for tracing any WooCommerce element to its source.\" />"},"121":{"id":"/docs-29","page_id":"/docs","tags":[],"type":"text","url":"/docs#where-to-go-next","content":"<Card title=\"Information Architecture\" href=\"/docs/about/information-architecture\" description=\"The full documentation map and how it is prioritized.\" />"},"122":{"id":"/docs/performance","page_id":"/docs/performance","type":"page","content":"Performance","breadcrumbs":["Docs"],"tags":[],"url":"/docs/performance"},"123":{"id":"/docs/performance-0","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance","content":"Where WooCommerce spends time and how to reduce it — object caching and sessions, autoloaded options, query and fragment cost, extension overhead, and headless considerations."},"124":{"id":"/docs/performance-1","page_id":"/docs/performance","type":"heading","tags":[],"url":"/docs/performance#object-caching-and-sessions","content":"Object caching and sessions"},"125":{"id":"/docs/performance-2","page_id":"/docs/performance","type":"heading","tags":[],"url":"/docs/performance#autoloaded-options","content":"Autoloaded options"},"126":{"id":"/docs/performance-3","page_id":"/docs/performance","type":"heading","tags":[],"url":"/docs/performance#query-and-fragment-cost","content":"Query and fragment cost"},"127":{"id":"/docs/performance-4","page_id":"/docs/performance","type":"heading","tags":[],"url":"/docs/performance#extension-overhead","content":"Extension overhead"},"128":{"id":"/docs/performance-5","page_id":"/docs/performance","type":"heading","tags":[],"url":"/docs/performance#headless-considerations","content":"Headless considerations"},"129":{"id":"/docs/performance-6","page_id":"/docs/performance","type":"heading","tags":[],"url":"/docs/performance#related","content":"Related"},"130":{"id":"/docs/performance-7","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance","content":"WooCommerce's performance story is mostly about **avoiding unindexed lookups\nand unnecessary per-request work** — several of the mechanisms that exist\nfor correctness (sessions, lookup tables, cart fragments) also happen to be\nthe biggest cost centers if left unmanaged. This page connects those dots\nrather than re-deriving them; each links to where the mechanism is\ndocumented in full."},"131":{"id":"/docs/performance-8","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance#object-caching-and-sessions","content":"WordPress's object cache (transient/`wp_cache_*` API) is a no-op back end by\ndefault — `wp_cache_set()` still \"works\" but nothing survives past the\nrequest unless a persistent object cache (Redis, Memcached) is installed."},"132":{"id":"/docs/performance-9","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance#object-caching-and-sessions","content":"Run a persistent object cache on any store with real traffic. WooCommerce\nreads and writes the customer's session\n(`woocommerce_sessions` — see\nDatabase)\non nearly every request that has a non-empty cart; without a persistent\nobject cache, session storage falls back to a database row read/write on\nevery single one of those requests."},"133":{"id":"/docs/performance-10","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance#autoloaded-options","content":"Every `wp_options` row with `autoload = 'yes'` is loaded into memory on\n**every** WordPress request, admin or front-end, whether that request needs\nit or not. `wp_options` has no index on `autoload`, so this scan itself gets\nmore expensive as the table grows."},"134":{"id":"/docs/performance-11","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance#autoloaded-options","content":"WooCommerce and its extensions are frequent contributors: large serialized\nsettings arrays, cached API responses stored as options instead of\ntransients, and (particularly) session and rate-limit rows that should never\nhave been autoloaded in the first place."},"135":{"id":"/docs/performance-12","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance#query-and-fragment-cost","content":"Two mechanisms exist specifically because a naive WordPress query was too\nslow at scale, and both still have a residual cost to manage:"},"136":{"id":"/docs/performance-13","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance#extension-overhead","content":"A filter or action that runs **once per product in a loop** — a catalog\npage, a cart with many line items, an export — turns any per-call cost\n(an uncached query, an external API call, expensive string formatting) into\nan N+1 problem invisible in isolation but severe at scale."},"137":{"id":"/docs/performance-14","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance#extension-overhead","content":"Profile with Query Monitor (or equivalent) on a shop/category page with a\nrealistic product count before shipping a filter on\n`woocommerce_get_price_html`, `woocommerce_product_get_price`, or any other\nfilter that fires per product in a loop. A single added query there is one\nquery times every product on the page."},"138":{"id":"/docs/performance-15","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance#headless-considerations","content":"A headless build talks to WooCommerce entirely through the\nStore API — the classic\n`wc-ajax`/cart-fragments machinery does not apply, since there is no\nserver-rendered page for it to refresh. The relevant costs shift to:"},"139":{"id":"/docs/performance-16","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance#headless-considerations","content":"**Cart/session continuity** — the Store API identifies a cart by a\n`Cart-Token`: an HS256 JWT (`Automattic\\WooCommerce\\StoreApi\\Utilities\\JsonWebToken`),\nsigned with a secret derived from `wp_salt()`, carrying the customer/session\nid and an `exp` claim set to issue time + `DAY_IN_SECONDS * 2` (48 hours,\nfilterable via `wc_session_expiration`) — rather than a PHP session cookie.\nThe client is responsible for persisting it and resending it as the\n`Cart-Token` request header on every call; there is no separate refresh\nendpoint, so a headless client needs to fetch a fresh cart (and token)\nonce the old one expires."},"140":{"id":"/docs/performance-17","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance#headless-considerations","content":"**No fragment cache to lean on** — every cart/checkout render is a fresh\nAPI call; caching strategy has to be built into the headless front end\nitself rather than inherited from server-rendered fragments."},"141":{"id":"/docs/performance-18","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance#related","content":"<Card title=\"Database\" href=\"/docs/data-storage/database\" description=\"The lookup tables that solve catalog query cost.\" />"},"142":{"id":"/docs/performance-19","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance#related","content":"<Card title=\"HPOS\" href=\"/docs/data-storage/hpos\" description=\"The order-table equivalent of the lookup-table pattern.\" />"},"143":{"id":"/docs/performance-20","page_id":"/docs/performance","tags":[],"type":"text","url":"/docs/performance#related","content":"<Card title=\"JavaScript\" href=\"/docs/development/javascript\" description=\"Cart fragments in full, including the per-request cost and how to dequeue it.\" />"},"144":{"id":"/docs/security","page_id":"/docs/security","type":"page","content":"Security","breadcrumbs":["Docs"],"tags":[],"url":"/docs/security"},"145":{"id":"/docs/security-0","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security","content":"The WooCommerce-specific security surface — nonces and capability checks in custom code, PII in orders and customers, payment-data boundaries, and safe AJAX/REST patterns."},"146":{"id":"/docs/security-1","page_id":"/docs/security","type":"heading","tags":[],"url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"Nonces and capability checks in custom code"},"147":{"id":"/docs/security-2","page_id":"/docs/security","type":"heading","tags":[],"url":"/docs/security#pii-in-orders-and-customers","content":"PII in orders and customers"},"148":{"id":"/docs/security-3","page_id":"/docs/security","type":"heading","tags":[],"url":"/docs/security#payment-data-boundaries","content":"Payment-data boundaries"},"149":{"id":"/docs/security-4","page_id":"/docs/security","type":"heading","tags":[],"url":"/docs/security#safe-ajaxrest","content":"Safe AJAX/REST"},"150":{"id":"/docs/security-5","page_id":"/docs/security","type":"heading","tags":[],"url":"/docs/security#related","content":"Related"},"151":{"id":"/docs/security-6","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security","content":"General WordPress hardening (server config, login security, file\npermissions) is out of scope here — this page covers the security surface\nthat is specific to building *on* WooCommerce: who is allowed to touch\norder/customer data, where personal and payment data legally and practically\nmay not sit, and the request paths (AJAX, REST) attackers actually probe."},"152":{"id":"/docs/security-7","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"These are two different questions and custom code needs both:"},"153":{"id":"/docs/security-8","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"Verify a nonce — `check_ajax_referer()` for AJAX,\n`wp_verify_nonce()` elsewhere. A nonce proves the request came from your\nown page, not that the requester is *allowed* to do this."},"154":{"id":"/docs/security-9","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"Check a capability with `current_user_can()`. A logged-in customer\npasses any nonce check on your own front-end form; only a capability (or\nan explicit ownership check) stops them acting on another customer's\norder."},"155":{"id":"/docs/security-10","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"A custom My Account endpoint, REST route, or AJAX handler that reads an\norder or customer by an ID taken from the request **without** confirming\nit belongs to the current user is an IDOR: any logged-in customer can\nsubstitute another order ID and read (or, worse, modify) someone else's\ndata. Check `$order->get_customer_id() === get_current_user_id()` (or the\nequivalent capability for staff) before returning anything."},"156":{"id":"/docs/security-11","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"Relevant built-in capabilities:"},"157":{"id":"/docs/security-12","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"Capability"},"158":{"id":"/docs/security-13","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"Grants"},"159":{"id":"/docs/security-14","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"`manage_woocommerce`"},"160":{"id":"/docs/security-15","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"Store settings, extensions, and everything the Shop Manager role can do"},"161":{"id":"/docs/security-16","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"`edit_shop_orders` / `edit_shop_order`"},"162":{"id":"/docs/security-17","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"View/edit orders in bulk, or one specific order"},"163":{"id":"/docs/security-18","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"`edit_others_shop_orders`"},"164":{"id":"/docs/security-19","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"Edit orders not created by the current user (relevant for a multi-staff setup)"},"165":{"id":"/docs/security-20","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"`WC_Install::create_roles()` grants the **Shop Manager** role\n`manage_woocommerce`, `view_woocommerce_reports`, `create_customers`, a set\nof baseline WordPress editor-level capabilities, and — for each of\n`product`, `shop_order`, and `shop_coupon` — the full standard post-type\ncapability set (`edit_/read_/delete_<type>`, `edit_others_<type>s`,\n`publish_<type>s`, and the rest). There is **no separate capability for\nHPOS or the custom order tables** — a store's storage mode is a feature\nflag, not something role-gated, so anyone with the `shop_order`\ncapabilities above has the same order access whichever mode is active."},"166":{"id":"/docs/security-21","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#nonces-and-capability-checks-in-custom-code","content":"The mechanics of nonces on WooCommerce's own AJAX transports (`wc-ajax` and\n`admin-ajax`) are covered in full on\nAJAX — Nonces and the params objects;\nthis section is the capability half that page does not focus on."},"167":{"id":"/docs/security-22","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#pii-in-orders-and-customers","content":"An order carries name, address, email, phone, and IP — all PII — whether or\nnot the store is otherwise GDPR-scoped. WooCommerce ships privacy tooling\nthat plugs into WordPress core's own personal-data tools rather than\nreinventing them:"},"168":{"id":"/docs/security-23","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#pii-in-orders-and-customers","content":"`WC_Privacy`'s constructor hooks `register_erasers_exporters()` onto\nWordPress `init`, which registers four exporter/eraser pairs — id\n`woocommerce-customer-data` (\"WooCommerce Customer Data\"),\n`woocommerce-customer-orders` (\"WooCommerce Customer Orders\"),\n`woocommerce-customer-downloads` (\"WooCommerce Customer Downloads\"), and\n`woocommerce-customer-tokens` (\"WooCommerce Customer Payment Tokens\") — each\nbacked by a callback on `WC_Privacy_Exporters` / `WC_Privacy_Erasers`. A\nplugin follows the same shape: extend `WC_Abstract_Privacy` and call its\n`add_exporter()` / `add_eraser()` for your own ids."},"169":{"id":"/docs/security-24","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#payment-data-boundaries","content":"WooCommerce core does not store raw card numbers, and a PCI-compliant\ngateway integration should never let them reach your server either — hosted\nfields or an iframe (Stripe Elements, PayPal, and similar) submit the card\ndirectly to the processor, and your server only ever handles a **token**."},"170":{"id":"/docs/security-25","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#payment-data-boundaries","content":"Any custom code that receives or logs a raw PAN, CVV, or full card number —\neven transiently, even to a debug log — pulls your server into full PCI-DSS\nscope. Log gateway responses, not raw request payloads; a `WC_Logger` entry\nis not a secure place for payment details."},"171":{"id":"/docs/security-26","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#payment-data-boundaries","content":"Stored payment methods live in `woocommerce_payment_tokens` (+ meta) — see\nDatabase —\nholding the token and display metadata (last four digits, card brand,\nexpiry), never the full card number."},"172":{"id":"/docs/security-27","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#safe-ajaxrest","content":"**AJAX** — every WooCommerce-provided `wc-ajax`/`admin-ajax` action\nalready nonce-checks; your own handlers must do the same, then a\ncapability check where the action is not purely public. Full pattern on\nAJAX."},"173":{"id":"/docs/security-28","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#safe-ajaxrest","content":"**REST API** — a consumer key/secret pair is scoped to Read, Write, or\nRead/Write, but ultimately executes with the capabilities of the WordPress\nuser it was generated for. A key generated against an over-privileged user\nis a bigger blast radius than the key's own read/write label suggests —\ngenerate integration keys against a dedicated, minimally-privileged user."},"174":{"id":"/docs/security-29","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#safe-ajaxrest","content":"**Incoming webhooks from a payment processor** — verify the processor's\nown signature scheme before trusting the payload; see\nPayments — Webhooks / IPN."},"175":{"id":"/docs/security-30","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#safe-ajaxrest","content":"**WooCommerce's own outgoing webhooks** (Settings → Advanced →\nWebhooks) sign each delivery with an HMAC-SHA256 hash of the payload,\nbase64-encoded into the `X-WC-Webhook-Signature` header, keyed by a secret\nset on the webhook. A receiver that does not recompute and compare that\nsignature will accept a forged delivery from anyone who finds the URL."},"176":{"id":"/docs/security-31","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#related","content":"<Card title=\"AJAX\" href=\"/docs/development/ajax\" description=\"The nonce mechanics referenced above, in full.\" />"},"177":{"id":"/docs/security-32","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#related","content":"<Card title=\"REST API\" href=\"/docs/development/rest-api\" description=\"Consumer keys, scopes, and the Store API.\" />"},"178":{"id":"/docs/security-33","page_id":"/docs/security","tags":[],"type":"text","url":"/docs/security#related","content":"<Card title=\"Payments\" href=\"/docs/lifecycle/payments\" description=\"Gateway tokenization and webhook/IPN signature verification.\" />"},"179":{"id":"/docs/about/design-system","page_id":"/docs/about/design-system","type":"page","content":"Documentation Design System","breadcrumbs":["Docs","About WooDoc"],"tags":[],"url":"/docs/about/design-system"},"180":{"id":"/docs/about/design-system-0","page_id":"/docs/about/design-system","tags":[],"type":"text","url":"/docs/about/design-system","content":"The reusable page templates and content components every WooDoc page is built from — so future documentation stays consistent, scannable, and fast to write."},"1