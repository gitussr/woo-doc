dcrumbs":["Docs","Commerce Lifecycle"],"tags":[],"url":"/docs/lifecycle/orders"},"1602":{"id":"/docs/lifecycle/orders-0","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders","content":"The order subsystem — the order statuses and what each means, the status-transition hook family, order items, stock reduction timing, refunds, and order notes."},"1603":{"id":"/docs/lifecycle/orders-1","page_id":"/docs/lifecycle/orders","type":"heading","tags":[],"url":"/docs/lifecycle/orders#statuses","content":"Statuses"},"1604":{"id":"/docs/lifecycle/orders-2","page_id":"/docs/lifecycle/orders","type":"heading","tags":[],"url":"/docs/lifecycle/orders#the-transition-hook-family","content":"The transition hook family"},"1605":{"id":"/docs/lifecycle/orders-3","page_id":"/docs/lifecycle/orders","type":"heading","tags":[],"url":"/docs/lifecycle/orders#stock-and-side-effects","content":"Stock and side effects"},"1606":{"id":"/docs/lifecycle/orders-4","page_id":"/docs/lifecycle/orders","type":"heading","tags":[],"url":"/docs/lifecycle/orders#order-items","content":"Order items"},"1607":{"id":"/docs/lifecycle/orders-5","page_id":"/docs/lifecycle/orders","type":"heading","tags":[],"url":"/docs/lifecycle/orders#refunds","content":"Refunds"},"1608":{"id":"/docs/lifecycle/orders-6","page_id":"/docs/lifecycle/orders","type":"heading","tags":[],"url":"/docs/lifecycle/orders#order-notes","content":"Order notes"},"1609":{"id":"/docs/lifecycle/orders-7","page_id":"/docs/lifecycle/orders","type":"heading","tags":[],"url":"/docs/lifecycle/orders#related","content":"Related"},"1610":{"id":"/docs/lifecycle/orders-8","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders","content":"An order is the durable record of a purchase. Its **status** drives almost\nevery side effect in WooCommerce — emails, stock, downloads, reports — so the\nstatus-transition hooks are the most important surface on this subsystem."},"1611":{"id":"/docs/lifecycle/orders-9","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders","content":"Storage (HPOS vs legacy) is covered in\nWooCommerce Data Model."},"1612":{"id":"/docs/lifecycle/orders-10","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Order statuses are stored with a `wc-` prefix internally and referred to\nwithout it in code (`$order->get_status()` returns `processing`, not\n`wc-processing`)."},"1613":{"id":"/docs/lifecycle/orders-11","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Status"},"1614":{"id":"/docs/lifecycle/orders-12","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Meaning"},"1615":{"id":"/docs/lifecycle/orders-13","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Typical trigger"},"1616":{"id":"/docs/lifecycle/orders-14","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"`pending`"},"1617":{"id":"/docs/lifecycle/orders-15","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Awaiting payment"},"1618":{"id":"/docs/lifecycle/orders-16","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Order just created"},"1619":{"id":"/docs/lifecycle/orders-17","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"`on-hold`"},"1620":{"id":"/docs/lifecycle/orders-18","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Awaiting payment confirmation / manual review"},"1621":{"id":"/docs/lifecycle/orders-19","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Offline gateway (BACS/cheque), or a fraud hold"},"1622":{"id":"/docs/lifecycle/orders-20","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"`processing`"},"1623":{"id":"/docs/lifecycle/orders-21","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Paid, needs fulfilment"},"1624":{"id":"/docs/lifecycle/orders-22","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Payment complete for a physical order"},"1625":{"id":"/docs/lifecycle/orders-23","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"`completed`"},"1626":{"id":"/docs/lifecycle/orders-24","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Fulfilled, nothing left to do"},"1627":{"id":"/docs/lifecycle/orders-25","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Admin marks it, or auto for downloads-only"},"1628":{"id":"/docs/lifecycle/orders-26","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"`cancelled`"},"1629":{"id":"/docs/lifecycle/orders-27","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Cancelled by admin or customer"},"1630":{"id":"/docs/lifecycle/orders-28","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Manual, or unpaid-order cleanup"},"1631":{"id":"/docs/lifecycle/orders-29","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"`refunded`"},"1632":{"id":"/docs/lifecycle/orders-30","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Fully refunded"},"1633":{"id":"/docs/lifecycle/orders-31","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"A refund covering the whole total"},"1634":{"id":"/docs/lifecycle/orders-32","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"`failed`"},"1635":{"id":"/docs/lifecycle/orders-33","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Payment failed or was declined"},"1636":{"id":"/docs/lifecycle/orders-34","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"Gateway rejection"},"1637":{"id":"/docs/lifecycle/orders-35","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"`wc_get_order_statuses()` returns exactly these seven (each `wc-` prefixed\ninternally: `wc-pending`, `wc-processing`, `wc-on-hold`, `wc-completed`,\n`wc-cancelled`, `wc-refunded`, `wc-failed&#x60;). There is also an internal\n&#x2A;*`wc-checkout-draft`** status for a Checkout-Block order that has not been\nplaced yet — it is registered but excluded from `wc_get_order_statuses()` and\nthe admin dropdown."},"1638":{"id":"/docs/lifecycle/orders-36","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#statuses","content":"To register a custom status, hook **all three**:\n`register_post_status()` for the status itself,\n`woocommerce_register_shop_order_post_statuses` so it works under HPOS, and\n`wc_order_statuses` to add it to the admin dropdown. Prefix the slug `wc-`."},"1639":{"id":"/docs/lifecycle/orders-37","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#the-transition-hook-family","content":"When an order's status changes, WooCommerce fires a cascade — hook the most\nspecific one that fits:"},"1640":{"id":"/docs/lifecycle/orders-38","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#the-transition-hook-family","content":"Status transition hooks can fire during checkout, from admin, from the REST\nAPI, from webhooks, and from bulk actions. Make the callback idempotent —\nguard with an order meta flag so re-running a transition does not double-send\nan email or double-charge a downstream system."},"1641":{"id":"/docs/lifecycle/orders-39","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#stock-and-side-effects","content":"Stock reduction is also gated by the store-wide `woocommerce_manage_stock`\noption and each product's `_manage_stock`."},"1642":{"id":"/docs/lifecycle/orders-40","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"The goods and money on an order are its **items**, not order meta:"},"1643":{"id":"/docs/lifecycle/orders-41","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"Item class"},"1644":{"id":"/docs/lifecycle/orders-42","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"`order_item_type`"},"1645":{"id":"/docs/lifecycle/orders-43","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"Carries"},"1646":{"id":"/docs/lifecycle/orders-44","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"`WC_Order_Item_Product`"},"1647":{"id":"/docs/lifecycle/orders-45","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"`line_item`"},"1648":{"id":"/docs/lifecycle/orders-46","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"product/variation id, qty, subtotal, total, tax"},"1649":{"id":"/docs/lifecycle/orders-47","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"`WC_Order_Item_Shipping`"},"1650":{"id":"/docs/lifecycle/orders-48","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"`shipping`"},"1651":{"id":"/docs/lifecycle/orders-49","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"method title, method id, cost, taxes"},"1652":{"id":"/docs/lifecycle/orders-50","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"`WC_Order_Item_Fee`"},"1653":{"id":"/docs/lifecycle/orders-51","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"`fee`"},"1654":{"id":"/docs/lifecycle/orders-52","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"name, amount, tax"},"1655":{"id":"/docs/lifecycle/orders-53","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"`WC_Order_Item_Coupon`"},"1656":{"id":"/docs/lifecycle/orders-54","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"`coupon`"},"1657":{"id":"/docs/lifecycle/orders-55","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"code, discount, discount tax"},"1658":{"id":"/docs/lifecycle/orders-56","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"`WC_Order_Item_Tax`"},"1659":{"id":"/docs/lifecycle/orders-57","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"`tax`"},"1660":{"id":"/docs/lifecycle/orders-58","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"rate id, label, tax total, shipping tax total"},"1661":{"id":"/docs/lifecycle/orders-59","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-items","content":"Iterate with `$order->get_items( 'line_item' )` (or `'fee'`, `'shipping'`, …).\nEach item is a CRUD object with its own `get_meta()` / `add_meta_data()`."},"1662":{"id":"/docs/lifecycle/orders-60","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#refunds","content":"A refund is a **negative child order** (`WC_Order_Refund`, post type\n`shop_order_refund` in legacy mode):"},"1663":{"id":"/docs/lifecycle/orders-61","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#refunds","content":"The full argument set is `amount`, `reason`, `order_id`, `refund_id`,\n`line_items`, `refund_payment`, `restock_items`. During the call\n`woocommerce_create_refund` fires (adjust the refund before save), then\n`woocommerce_refund_created`, `woocommerce_order_refunded`, and one of\n`woocommerce_order_partially_refunded` / `woocommerce_order_fully_refunded`."},"1664":{"id":"/docs/lifecycle/orders-62","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#refunds","content":"A refund covering the full total moves the order to `refunded`."},"1665":{"id":"/docs/lifecycle/orders-63","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#refunds","content":"`refund_payment => true` only works when the gateway declares\n`supports( 'refunds' )` — otherwise the refund is recorded but the money\nmust be moved manually in the processor."},"1666":{"id":"/docs/lifecycle/orders-64","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#order-notes","content":"`$order->add_order_note( $text, $is_customer_note = false )`. Customer notes\ntrigger the \"Note to customer\" email; private notes are admin-only. System\nevents (payment, status changes, gateway messages) are recorded as notes\nautomatically — the note history is the first place to look when debugging an\norder."},"1667":{"id":"/docs/lifecycle/orders-65","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#related","content":"<Card title=\"Checkout\" href=\"/docs/lifecycle/checkout\" description=\"How the order is created before this lifecycle begins.\" />"},"1668":{"id":"/docs/lifecycle/orders-66","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#related","content":"<Card title=\"Payments\" href=\"/docs/lifecycle/payments\" description=\"What drives the pending → processing transition.\" />"},"1669":{"id":"/docs/lifecycle/orders-67","page_id":"/docs/lifecycle/orders","tags":[],"type":"text","url":"/docs/lifecycle/orders#related","content":"<Card title=\"Emails\" href=\"/docs/lifecycle/emails\" description=\"The transactional emails wired to these transitions.\" />"},"1670":{"id":"/docs/lifecycle/payments","page_id":"/docs/lifecycle/payments","type":"page","content":"Payments","breadcrumbs":["Docs","Commerce Lifecycle"],"tags":[],"url":"/docs/lifecycle/payments"},"1671":{"id":"/docs/lifecycle/payments-0","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments","content":"The payment subsystem — the WC_Payment_Gateway interface, the process_payment contract, redirect vs direct gateways, webhooks/IPN and the WC API endpoint, marking an order paid, saved payment methods (tokenization), and the Blocks payment method API."},"1672":{"id":"/docs/lifecycle/payments-1","page_id":"/docs/lifecycle/payments","type":"heading","tags":[],"url":"/docs/lifecycle/payments#the-gateway-interface","content":"The gateway interface"},"1673":{"id":"/docs/lifecycle/payments-2","page_id":"/docs/lifecycle/payments","type":"heading","tags":[],"url":"/docs/lifecycle/payments#the-process_payment-contract","content":"The `process_payment()` contract"},"1674":{"id":"/docs/lifecycle/payments-3","page_id":"/docs/lifecycle/payments","type":"heading","tags":[],"url":"/docs/lifecycle/payments#redirect-vs-direct","content":"Redirect vs direct"},"1675":{"id":"/docs/lifecycle/payments-4","page_id":"/docs/lifecycle/payments","type":"heading","tags":[],"url":"/docs/lifecycle/payments#webhooks--ipn","content":"Webhooks / IPN"},"1676":{"id":"/docs/lifecycle/payments-5","page_id":"/docs/lifecycle/payments","type":"heading","tags":[],"url":"/docs/lifecycle/payments#marking-an-order-paid","content":"Marking an order paid"},"1677":{"id":"/docs/lifecycle/payments-6","page_id":"/docs/lifecycle/payments","type":"heading","tags":[],"url":"/docs/lifecycle/payments#saved-payment-methods-tokenization","content":"Saved payment methods (tokenization)"},"1678":{"id":"/docs/lifecycle/payments-7","page_id":"/docs/lifecycle/payments","type":"heading","tags":[],"url":"/docs/lifecycle/payments#blocks","content":"Blocks"},"1679":{"id":"/docs/lifecycle/payments-8","page_id":"/docs/lifecycle/payments","type":"heading","tags":[],"url":"/docs/lifecycle/payments#related","content":"Related"},"1680":{"id":"/docs/lifecycle/payments-9","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments","content":"A payment gateway is an adapter between WooCommerce's order and an external\npayment processor. WooCommerce defines the interface; the gateway implements\n`process_payment()` and, usually, a webhook handler. This page is the shape of\nthat interface, not a guide to any one processor."},"1681":{"id":"/docs/lifecycle/payments-10","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#the-gateway-interface","content":"A gateway extends `WC_Payment_Gateway` and is registered via the\n`woocommerce_payment_gateways` filter."},"1682":{"id":"/docs/lifecycle/payments-11","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#the-process_payment-contract","content":"`process_payment()` returns `array( 'result' => 'success', 'redirect' => $url )`\non success (WooCommerce redirects the browser there) or\n`array( 'result' => 'failure' )` on failure (the checkout page re-renders with\nany notices you added). `get_return_url( $order )` is the order-received\n(\"thank you\") URL. `payment_complete( $transaction_id = '' )` records the\ntransaction and moves the order forward — see below."},"1683":{"id":"/docs/lifecycle/payments-12","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#redirect-vs-direct","content":"`process_payment()` returns a `redirect` to the processor. The customer\npays off-site and is sent back to a return URL. The order is confirmed\nfrom the **webhook**, not the browser return (the customer may never come\nback)."},"1684":{"id":"/docs/lifecycle/payments-13","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#redirect-vs-direct","content":"The token is submitted with the order; `process_payment()` charges it\nserver-to-server and completes the order inline."},"1685":{"id":"/docs/lifecycle/payments-14","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#webhooks--ipn","content":"Asynchronous processor notifications (\"this payment succeeded / was disputed /\nwas refunded\") arrive at a WooCommerce-provided URL:"},"1686":{"id":"/docs/lifecycle/payments-15","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#webhooks--ipn","content":"`WC()->api_request_url( 'my_gateway' )` returns\n`home_url( '/wc-api/my_gateway/' )` (or the `?wc-api=my_gateway` form).\n`WC_API::handle_api_requests()` fires `woocommerce_api_my_gateway` when that\nURL is hit — this predates the REST API and is still the common gateway\nwebhook mechanism; a custom `register_rest_route()` endpoint works too."},"1687":{"id":"/docs/lifecycle/payments-16","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#webhooks--ipn","content":"The handler must **verify the processor's signature**, look the order up,\nand move it (`$order->payment_complete()`,\n`$order->update_status( 'failed' )`, `$order->add_order_note()`)."},"1688":{"id":"/docs/lifecycle/payments-17","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#webhooks--ipn","content":"A webhook endpoint with no signature verification lets anyone mark any order\npaid. Verify the processor's signature on every call, and treat the payload\nas untrusted input."},"1689":{"id":"/docs/lifecycle/payments-18","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#marking-an-order-paid","content":"`$order->payment_complete( $txn_id )` is the single entry point:"},"1690":{"id":"/docs/lifecycle/payments-19","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#saved-payment-methods-tokenization","content":"Piece"},"1691":{"id":"/docs/lifecycle/payments-20","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#saved-payment-methods-tokenization","content":"Role"},"1692":{"id":"/docs/lifecycle/payments-21","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#saved-payment-methods-tokenization","content":"`WC_Payment_Token` (abstract) + `WC_Payment_Token_CC` / `WC_Payment_Token_eCheck`"},"1693":{"id":"/docs/lifecycle/payments-22","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#saved-payment-methods-tokenization","content":"A stored reference to a payment method (`gateway_id`, `token`, `user_id`, `type`, `is_default`; CC adds `last4`, `expiry_month/year`, `card_type`) — never raw card data"},"1694":{"id":"/docs/lifecycle/payments-23","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#saved-payment-methods-tokenization","content":"`WC_Payment_Tokens`"},"1695":{"id":"/docs/lifecycle/payments-24","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#saved-payment-methods-tokenization","content":"The facade: `get_customer_tokens()`, `get_order_tokens()`, `get()`, `get_customer_default_token()`"},"1696":{"id":"/docs/lifecycle/payments-25","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#saved-payment-methods-tokenization","content":"`$gateway->supports( 'tokenization' )`"},"1697":{"id":"/docs/lifecycle/payments-26","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#saved-payment-methods-tokenization","content":"Enables the \"save method\" checkbox and the saved-methods list at checkout"},"1698":{"id":"/docs/lifecycle/payments-27","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#saved-payment-methods-tokenization","content":"Tokens live in `wp_woocommerce_payment_tokens` + `wp_woocommerce_payment_tokenmeta`.\nThe processor holds the sensitive data; WooCommerce stores only its token —\nwhich keeps most stores out of PCI-DSS scope for card data."},"1699":{"id":"/docs/lifecycle/payments-28","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#blocks","content":"The Checkout Block does not call `payment_fields()`. A gateway registers a\n**payment method integration** for the Block separately:"},"1700":{"id":"/docs/lifecycle/payments-29","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#blocks","content":"**Client** — a JS config object (`name`, `label`, `content`, `edit`,\n`canMakePayment`, `ariaLabel`, `supports`) passed to `registerPaymentMethod()`\n(or `registerExpressPaymentMethod()` for express buttons) from\n`@woocommerce/blocks-registry`."},"1701":{"id":"/docs/lifecycle/payments-30","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#blocks","content":"**Server** — a class extending\n`Automattic\\WooCommerce\\Blocks\\Payments\\Integrations\\AbstractPaymentMethodType`,\nregistered on the `woocommerce_blocks_payment_method_type_registration`\naction (inside a `woocommerce_blocks_loaded` callback) via\n`$payment_method_registry->register( new My_Method() )`."},"1702":{"id":"/docs/lifecycle/payments-31","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#related","content":"<Card title=\"Orders\" href=\"/docs/lifecycle/orders\" description=\"The status transitions payment_complete() drives.\" />"},"1703":{"id":"/docs/lifecycle/payments-32","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#related","content":"<Card title=\"Checkout\" href=\"/docs/lifecycle/checkout\" description=\"Where process_payment() is called from.\" />"},"1704":{"id":"/docs/lifecycle/payments-33","page_id":"/docs/lifecycle/payments","tags":[],"type":"text","url":"/docs/lifecycle/payments#related","content":"<Card title=\"REST API\" href=\"/docs/development/rest-api\" description=\"The wc-api endpoint mechanism used for webhooks.\" />"},"1705":{"id":"/docs/lifecycle/products","page_id":"/docs/lifecycle/products","type":"page","content":"Products","breadcrumbs":["Docs","Commerce Lifecycle"],"tags":[],"url":"/docs/lifecycle/products"},"1706":{"id":"/docs/lifecycle/products-0","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products","content":"The product subsystem — the built-in product types and their CRUD classes, how variable products and variations fit together, the price fields and the price pipeline, and how stock is tracked and held."},"1707":{"id":"/docs/lifecycle/products-1","page_id":"/docs/lifecycle/products","type":"heading","tags":[],"url":"/docs/lifecycle/products#product-types","content":"Product types"},"1708":{"id":"/docs/lifecycle/products-2","page_id":"/docs/lifecycle/products","type":"heading","tags":[],"url":"/docs/lifecycle/products#variable-products-and-variations","content":"Variable products and variations"},"1709":{"id":"/docs/lifecycle/products-3","page_id":"/docs/lifecycle/products","type":"heading","tags":[],"url":"/docs/lifecycle/products#the-price-pipeline","content":"The price pipeline"},"1710":{"id":"/docs/lifecycle/products-4","page_id":"/docs/lifecycle/products","type":"heading","tags":[],"url":"/docs/lifecycle/products#stock","content":"Stock"},"1711":{"id":"/docs/lifecycle/products-5","page_id":"/docs/lifecycle/products","type":"heading","tags":[],"url":"/docs/lifecycle/products#stock-changes-through-the-order-lifecycle","content":"Stock changes through the order lifecycle"},"1712":{"id":"/docs/lifecycle/products-6","page_id":"/docs/lifecycle/products","type":"heading","tags":[],"url":"/docs/lifecycle/products#extension-surface","content":"Extension surface"},"1713":{"id":"/docs/lifecycle/products-7","page_id":"/docs/lifecycle/products","type":"heading","tags":[],"url":"/docs/lifecycle/products#related","content":"Related"},"1714":{"id":"/docs/lifecycle/products-8","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products","content":"A product is the catalog entity everything else in WooCommerce is priced and\nstocked against. This page covers what a product *is* at runtime, how the\nprice you see is assembled, and how stock is tracked. The storage layout is in\nWooCommerce Data Model;\nthis page is about behavior."},"1715":{"id":"/docs/lifecycle/products-9","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"The `product_type` taxonomy term on the product selects a CRUD subclass:"},"1716":{"id":"/docs/lifecycle/products-10","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"Type"},"1717":{"id":"/docs/lifecycle/products-11","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"Class"},"1718":{"id":"/docs/lifecycle/products-12","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"What it is"},"1719":{"id":"/docs/lifecycle/products-13","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"`simple`"},"1720":{"id":"/docs/lifecycle/products-14","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"`WC_Product_Simple`"},"1721":{"id":"/docs/lifecycle/products-15","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"One SKU, one price, optional stock"},"1722":{"id":"/docs/lifecycle/products-16","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"`variable`"},"1723":{"id":"/docs/lifecycle/products-17","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"`WC_Product_Variable`"},"1724":{"id":"/docs/lifecycle/products-18","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"A parent with attributes; buyable variations are its children"},"1725":{"id":"/docs/lifecycle/products-19","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"`grouped`"},"1726":{"id":"/docs/lifecycle/products-20","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"`WC_Product_Grouped`"},"1727":{"id":"/docs/lifecycle/products-21","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"A display container that links to other simple products; not itself purchasable"},"1728":{"id":"/docs/lifecycle/products-22","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"`external`"},"1729":{"id":"/docs/lifecycle/products-23","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"`WC_Product_External`"},"1730":{"id":"/docs/lifecycle/products-24","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"An \"affiliate\" product — the add-to-cart button links off-site"},"1731":{"id":"/docs/lifecycle/products-25","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"Extensions register more (`subscription`, `bundle`, `booking`, …) by adding a\n`product_type` term and hooking `woocommerce_product_class`\n(`$classname, $product_type, $post_type, $product_id`), which\n`WC_Product_Factory` applies when resolving the class for a product."},"1732":{"id":"/docs/lifecycle/products-26","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#product-types","content":"Get the right object with `wc_get_product( $id )` — it returns the correct\nsubclass. Check with `$product->get_type()` or `$product->is_type( 'variable' )`."},"1733":{"id":"/docs/lifecycle/products-27","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"A product carries three stored price fields and one computed one:"},"1734":{"id":"/docs/lifecycle/products-28","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"Field"},"1735":{"id":"/docs/lifecycle/products-29","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"Getter"},"1736":{"id":"/docs/lifecycle/products-30","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"Meaning"},"1737":{"id":"/docs/lifecycle/products-31","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"Regular price"},"1738":{"id":"/docs/lifecycle/products-32","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"`get_regular_price()`"},"1739":{"id":"/docs/lifecycle/products-33","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"The normal price"},"1740":{"id":"/docs/lifecycle/products-34","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"Sale price"},"1741":{"id":"/docs/lifecycle/products-35","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"`get_sale_price()`"},"1742":{"id":"/docs/lifecycle/products-36","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"The discounted price, if any"},"1743":{"id":"/docs/lifecycle/products-37","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"Active price"},"1744":{"id":"/docs/lifecycle/products-38","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"`get_price()`"},"1745":{"id":"/docs/lifecycle/products-39","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"Sale price when a sale is on, else regular price"},"1746":{"id":"/docs/lifecycle/products-40","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"—"},"1747":{"id":"/docs/lifecycle/products-41","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"`get_price_html()`"},"1748":{"id":"/docs/lifecycle/products-42","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"The formatted string with currency, \"was/now\", suffix"},"1749":{"id":"/docs/lifecycle/products-43","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"Change the value with woocommerce\\_product\\_get\\_price /\n\\_get\\_regular\\_price / \\_get\\_sale\\_price (and the\n*variation* equivalents). Change the display with\nwoocommerce\\_get\\_price\\_html. See\nFilters."},"1750":{"id":"/docs/lifecycle/products-44","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"For per-customer or per-cart pricing, do not filter\nget\\_price globally — it fires everywhere and you will fight\ncaching and admin screens. Set the line price during cart calculation\ninstead (see Cart)."},"1751":{"id":"/docs/lifecycle/products-45","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#the-price-pipeline","content":"Whether a sale is \"on\" also depends on the sale schedule\n(`_sale_price_dates_from` / `_sale_price_dates_to`). `wc_scheduled_sales()`\nruns on the **daily** `woocommerce_scheduled_sales` cron event to start and\nend scheduled sales — so a sale ending mid-day is not cleared to the minute."},"1752":{"id":"/docs/lifecycle/products-46","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#stock","content":"Stock is tracked at two levels and expressed two ways:"},"1753":{"id":"/docs/lifecycle/products-47","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#stock-changes-through-the-order-lifecycle","content":"Stock management overall is gated by the per-product `_manage_stock` and the\nstore-wide `woocommerce_manage_stock` option."},"1754":{"id":"/docs/lifecycle/products-48","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#stock-changes-through-the-order-lifecycle","content":"WooCommerce 11.0 enables **product object caching by default for new\nstores** and includes query optimizations for large catalogs and variable\nproducts. Reads of `wc_get_product()` may be served from the object cache;\nwrites invalidate it."},"1755":{"id":"/docs/lifecycle/products-49","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#extension-surface","content":"You want to…"},"1756":{"id":"/docs/lifecycle/products-50","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#extension-surface","content":"Use"},"1757":{"id":"/docs/lifecycle/products-51","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#extension-surface","content":"Add a field to the product editor"},"1758":{"id":"/docs/lifecycle/products-52","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#extension-surface","content":"Render on `woocommerce_product_options_general_product_data` / `_pricing` / `_inventory_product_data` / `_shipping_product_data` / `_advanced` (or add a tab via `woocommerce_product_data_tabs` + `woocommerce_product_data_panels`); save on `woocommerce_admin_process_product_object` (set on the `$product` object) or `woocommerce_process_product_meta`"},"1759":{"id":"/docs/lifecycle/products-53","page_id":"/docs/lifecycle/products","tags":[],"type":"text","url":"/docs/lifecycle/products#extension-surface","content":"Add a product type"},"1760":{"id":"/docs/lifecycle/products-54","page_i